# ─────────────────────────────────────────────────────────────────────────────
# MBB ya Kin — Environment Configuration Template
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values below
# 3. Create every ./secrets/*.txt file referenced below with deployment-specific values.
#
# RULE: Passwords and API keys go in ./secrets/*.txt — NOT in this file.
#       This file is committed to git; ./secrets/ is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                         # development | production
DEBUG=true                                  # true | false
TZ=Africa/Kinshasa

# ── WhatsApp Mode ─────────────────────────────────────────────────────────────
WHATSAPP_MODE=baileys                       # baileys (dev) | official (prod)

# ── Recovery Safety Gates ─────────────────────────────────────────────────────
# Recovery defaults are intentionally no-side-effect. Enable integrations only
# in a separate validated step with explicit user approval.
WHATSAPP_SEND_ENABLED=false
CRM_SEND_ENABLED=false
PAYMENT_SEND_ENABLED=false
RELANCE_ENABLED=false
SCHEDULED_TASKS_ENABLED=false
M1_MAPS_FANOUT_ENABLED=false

# ── Adapter Selection ─────────────────────────────────────────────────────────
AI_ADAPTER=disabled                         # recovery default; options: disabled | claude
CRM_ADAPTER=airtable                        # airtable | mbb_hub (Phase 2)
INVENTORY_ADAPTER=static                    # static | mbb_box (Phase 2+)
PAYMENT_ADAPTER=mobile_money                # mobile_money
MESSAGING_ADAPTER=whatsapp                  # whatsapp

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Credentials are read from ./secrets/ files — do NOT put them here.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Africa/Kinshasa

# ── AI — Claude ───────────────────────────────────────────────────────────────
# CLAUDE_API_KEY → ./secrets/claude_api_key.txt
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT_S=25

# ── CRM — Airtable ────────────────────────────────────────────────────────────
# AIRTABLE_API_KEY → ./secrets/airtable_api_key.txt
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_ORDERS_TABLE=Orders

# ── WhatsApp Official API (prod only) ─────────────────────────────────────────
# WHATSAPP_API_TOKEN → ./secrets/whatsapp_api_token.txt
# WHATSAPP_VERIFY_TOKEN → ./secrets/whatsapp_verify_token.txt
# WHATSAPP_API_SECRET → ./secrets/whatsapp_api_secret.txt
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=

# ── Baileys Bridge (dev only) ─────────────────────────────────────────────────
BAILEYS_HOST=baileys
BAILEYS_PORT=3000

# ── Payment Gateways ──────────────────────────────────────────────────────────
# Keys → ./secrets/orange_money_key.txt, airtel_money_key.txt, mpesa_key.txt
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# ── JWT ───────────────────────────────────────────────────────────────────────
# JWT_SECRET → ./secrets/jwt_secret.txt
# Pre-issued dashboard JWT → ./secrets/dashboard_api_token.txt
# Dashboard htpasswd entry → ./secrets/dashboard_basic_auth.txt
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_SERVER_NAME=localhost                 # Change to your domain in prod

# ── Observability ─────────────────────────────────────────────────────────────
LOKI_URL=http://loki:3100
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
