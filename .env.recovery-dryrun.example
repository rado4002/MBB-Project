# MBB ya Kin — Recovery Runtime Dry-Run Environment Template
#
# Copy to `.env.recovery-dryrun` for local execution in Step 18D.
# This file contains only non-secret, no-side-effect settings.
# Do not add real provider credentials here.

APP_ENV=production
DEBUG=false
TZ=Africa/Kinshasa
LOG_LEVEL=INFO
ENABLE_METRICS=false

WHATSAPP_MODE=official
AI_ADAPTER=disabled
WHATSAPP_SEND_ENABLED=false
CRM_SEND_ENABLED=false
PAYMENT_SEND_ENABLED=false
RELANCE_ENABLED=false
SCHEDULED_TASKS_ENABLED=false

CRM_ADAPTER=airtable
INVENTORY_ADAPTER=static
PAYMENT_ADAPTER=mobile_money
MESSAGING_ADAPTER=whatsapp

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mbb
POSTGRES_USER=mbb_dryrun
POSTGRES_PASSWORD=mbb_dryrun_password_not_secret

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Africa/Kinshasa
