# ─────────────────────────────────────────────────────────────────────────────
# Nginx — Production SSL Site Config
# Used via docker-compose.prod.yml volume override.
# Certificates must be placed in ./nginx/certs/
# ─────────────────────────────────────────────────────────────────────────────

# Redirect HTTP → HTTPS
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # ── HSTS ──────────────────────────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";

    # ── Webhook ───────────────────────────────────────────────────────────────
    location /api/v1/messages/ {
        limit_req zone=webhook burst=10 nodelay;
        proxy_pass         http://mbb_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
        proxy_connect_timeout 10s;
        client_max_body_size 10k;
    }

    # ── API ───────────────────────────────────────────────────────────────────
    location /api/ {
        limit_req zone=api burst=30 nodelay;
        proxy_pass         http://mbb_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
        client_max_body_size 10k;
    }

    # ── Health ────────────────────────────────────────────────────────────────
    location /health {
        proxy_pass http://mbb_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # ── Prometheus metrics (internal only in prod) ────────────────────────────
    location /metrics {
        allow 127.0.0.1;
        allow 172.20.0.0/16;
        deny all;
        proxy_pass http://mbb_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # ── Dashboard (HTTP Basic Auth via htpasswd) ───────────────────────────────
    location /dashboard/ {
        auth_basic "MBB Dashboard";
        auth_basic_user_file /run/secrets/dashboard_basic_auth;
        limit_req zone=dashboard burst=20 nodelay;
        proxy_pass         http://mbb_dashboard/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
