# MBB ya Kin — recovery-live static rendering template
# Placeholder values only. Create a separate ignored runtime file for a controlled test.

APP_ENV=production
DEBUG=false
TZ=Africa/Kinshasa
LOG_LEVEL=INFO
ENABLE_METRICS=false

WHATSAPP_MODE=baileys
AI_ADAPTER=disabled
WHATSAPP_SEND_ENABLED=false
BAILEYS_SEND_MAX_ATTEMPTS=1
CRM_SEND_ENABLED=false
PAYMENT_SEND_ENABLED=false
RELANCE_ENABLED=false
SCHEDULED_TASKS_ENABLED=false
M1_MAPS_FANOUT_ENABLED=false

POSTGRES_DB=mbb
POSTGRES_USER=mbb_recovery_live_placeholder
POSTGRES_PASSWORD=SET_TEMPORARY_RECOVERY_DATABASE_PASSWORD
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

RECOVERY_BAILEYS_PORT=13000
RECOVERY_BAILEYS_SESSION_VOLUME=SET_UNIQUE_RECOVERY_SESSION_VOLUME
BAILEYS_OUTBOUND_LEDGER_DIR=/app/outbound-ledger
BAILEYS_RECOVERY_TOKEN=SET_STRONG_TEMPORARY_TOKEN
BAILEYS_WEBHOOK_SECRET=SET_MATCHING_RECOVERY_WEBHOOK_SECRET
